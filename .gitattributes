# Git for Windows with core.autocrlf=true checks Go sources out as CRLF and
# makes `gofmt -l` flag every file. Keep Go sources LF on every checkout.
*.go text eol=lf
assets/banner.txt text eol=lf
assets/banner-compact.txt text eol=lf
# A CRLF shebang breaks LaunchServices before the app starts; plists stay
# consistent for the macOS packaging.
*.sh text eol=lf
macos/launcher text eol=lf
*.plist text eol=lf
